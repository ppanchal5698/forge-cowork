# Same variable names in local dev and production — only values differ (CLAUDE.md §3).
# These values are for tools/scripts running on the HOST. Inside docker-compose,
# services use container hostnames (ministack, postgres, neo4j, ollama, redis).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=forgelocal
OLLAMA_BASE_URL=http://localhost:11434
REDIS_URL=redis://localhost:6379/0
